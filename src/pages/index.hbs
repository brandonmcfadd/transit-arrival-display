<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>CTA Arrivals</title>
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <style>
    html,
    body {
      margin: 0;
      padding: 0;
      height: 100%;
      width: 100%;
      overflow: hidden;
      background-color: #000;
      font-family: Arial, sans-serif;
      color: white;
    }

    .bold {
      font-weight: bold;
    }

    .arrivals {
      display: flex;
      flex-direction: column;
      height: 100%;
      padding: 0;
      box-sizing: border-box;
    }

    .loading {
      flex-grow: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5vw;
    }

    #sourceWarning {
      position: fixed;
      z-index: 1;
      bottom: 0.5rem;
      left: 50%;
      transform: translateX(-50%);
      max-width: 90%;
      padding: 0.5rem 1rem;
      background: #7a4e00;
      color: white;
      font-size: 1rem;
      text-align: center;
    }

    #sourceWarning[hidden] {
      display: none;
    }

    #arrivalContainer {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      overflow-y: auto;
      width: 100%;
      gap: 1px;
    }

    .filter-info {
      display: flex;
      width: 100%;
      height: 2rem;
      background-color: #333;
      color: #ccc;
      font-size: 1rem;
      padding: 0.5rem;
      box-sizing: border-box;
      align-items: center;
      justify-content: center;
      text-align: center;
      flex-shrink: 0;
    }

    .filter-info[hidden] {
      display: none;
    }

    .train-entry {
      display: flex;
      width: 100%;
      height: 100vh;
      background-color: var(--line-color, #000);
      /* Default to black */
      color: white;
      /* Default text color */
    }

    .train-entry-number {
      background-color: #333;
      color: #ddd;
      font-weight: bold;
      padding: 0.25em 0.5em 0.25em 0.5em;
      font-size: 1.25rem;
      display: flex;
      align-items: center;
      text-align: center;
      width: 1.5rem;
    }

    .train-entry-body {
      flex-grow: 1;
      padding: 0.25em 0.5em;
      display: flex;
      align-items: center;
    }

    .train-entry-details {
      display: flex;
      flex: 0 0 auto;
      flex-direction: column;
    }

    .train-entry-run-info {
      font-size: 1.5rem;
    }

    .train-entry-dest {
      font-weight: bold;
      font-size: 3rem;
    }

    .train-entry-timing {
      font-size: 3rem;
      margin-left: auto;
    }

    .train-entry-tracking img {
      height: 2.5rem;
      width: auto;
      padding: 0 1.7vw;
    }

    .train-entry[data-line="yellow"] {
      color: black;
      /* Yellow line text should be black */
    }

    .inverted {
      background-color: white !important;
      color: var(--line-color) !important;
      /* Set text color dynamically */
    }

    .holidayTrain {
      background: #C60C30;
      background: linear-gradient(125deg, rgba(198, 12, 48, 1) 0%, rgba(0, 155, 58, 1) 10%, rgba(198, 12, 48, 1) 20%, rgba(0, 155, 58, 1) 30%, rgba(198, 12, 48, 1) 40%, rgba(0, 155, 58, 1) 50%, rgba(198, 12, 48, 1) 60%, rgba(0, 155, 58, 1) 70%, rgba(198, 12, 48, 1) 80%, rgba(0, 155, 58, 1) 90%, rgba(198, 12, 48, 1) 100%);
    }

    .prideTrain {
      background: #C60C30;
      background: linear-gradient(125deg, rgba(198, 12, 48, 1) 0%, rgba(249, 70, 28, 1) 15%, rgba(249, 227, 0, 1) 30%, rgba(0, 155, 58, 1) 44%, rgba(0, 161, 222, 1) 58%, rgba(226, 126, 166, 1) 72%, rgba(82, 35, 152, 1) 86%, rgba(98, 54, 27, 1) 100%);
    }

    .train-entry-candy-cane img {
      height: 2.5rem;
      width: auto;
      padding: 0 1.7vw;
    }

    .arrival-viewport {
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    .arrival-viewport #arrivalContainer {
      height: 100%;
    }
  </style>
</head>

<body>
  <div class="arrivals">
    <div class="loading">Loading...</div>
    <div id="filterInfo" class="filter-info" hidden>
      <span id="filterMessage"></span><span id="refreshSeparator" hidden>&nbsp;|&nbsp;</span><span id="refreshAge"></span>
    </div>
    <div class="arrival-viewport">
      <div id="arrivalContainer" style="display: none;"></div>
    </div>
  </div>
  <div id="sourceWarning" role="status" hidden></div>

  <script src="/arrival-transitions.js"></script>
  <script>
    const routeColors = {
      red: '#C60C30',
      blue: '#00A1DE',
      brown: '#62361B',
      green: '#009B3A',
      orange: '#F9461C',
      pink: '#E27EA6',
      purple: '#522398',
      yellow: '#F9E300',
      bus: '#0165BD',
    };
    const imageCache = new Map();

    function getCachedImage(src) {
      if (!imageCache.has(src)) {
        const img = new Image();
        img.src = src;
        img.alt = "Tracking";
        img.loading = "lazy";
        imageCache.set(src, img);
      }
      return imageCache.get(src).cloneNode(true);
    }

    function getUrlParams() {
      const params = new URLSearchParams(window.location.search);
      let paramsObj = {};
      for (const [key, value] of params) {
        paramsObj[key] = value;
      }
      return paramsObj;
    }

    function getRouteColor(route) {
      return routeColors[route.toLowerCase()] || '#ffffff';
    }

    let refreshInProgress = false;

    async function fetchArrivals() {
      if (refreshInProgress) return;
      refreshInProgress = true;
      const container = document.getElementById('arrivalContainer');
      const filterMessage = document.getElementById('filterMessage');
      const slideDuration = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 200;

      const params = getUrlParams();
      const trainWalkTime = Number(params.trainWalkTime || params.walkTime || 0);
      const busWalkTime = Number(params.busWalkTime || 0);
      const url = new URL('/api/cta-arrivals', window.location.origin);
      Object.keys(params).forEach(key => {
        url.searchParams.append(key, params[key]);
      });

      try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Failed to fetch data');
        const sourceErrors = response.headers.get('X-CTA-Source-Errors');
        const sourceWarning = document.getElementById('sourceWarning');
        sourceWarning.textContent = sourceErrors
          ? `${decodeURIComponent(sourceErrors)}`
          : '';
        sourceWarning.hidden = !sourceErrors;
        const responseData = await response.json();
        const { arrivals, filteredCounts } = responseData;

        document.querySelector('.loading').style.display = 'none';
        container.style.display = 'flex';

        const filterInfo = document.getElementById('filterInfo');
        const hasFiltered = filteredCounts.trains > 0 || filteredCounts.buses > 0;
        if (hasFiltered) {
          const trainMsg = filteredCounts.trains > 0
            ? `${filteredCounts.trains} train${filteredCounts.trains > 1 ? 's' : ''} arriving in less than ${trainWalkTime} minutes`
            : '';
          const busMsg = filteredCounts.buses > 0
            ? `${filteredCounts.buses} bus${filteredCounts.buses > 1 ? 'es' : ''} arriving in less than ${busWalkTime} minutes`
            : '';
          const parts = [trainMsg, busMsg].filter(Boolean);
          filterMessage.textContent = `Due to required walk time, ${parts.join(' and ')} have been hidden.`;
        } else {
          filterMessage.textContent = '';
        }

        // Sort and render entries
        arrivals.sort((a, b) => a.arrivalTime - b.arrivalTime);
        const vh = window.innerHeight;
        const maxEntries = vh / 95;
        const rowHeight = `6rem`;

        const keyCounts = new Map();
        const nextRows = arrivals.slice(0, maxEntries).map((arrival, index) => {
          const line = arrival.route;
          const lineColor = getRouteColor(line);
          const lineKey = line.toLowerCase();
          const isInverted = arrival.destination === 'Cottage Grove' || arrival.destination === 'UIC-Halsted';
          const isHolidayTrain = arrival.isHoliday
          const isPrideTrain = arrival.isPride

          const trainEntry = document.createElement('div');
          const key = arrivalRowKey(arrival);
          const occurrence = keyCounts.get(key) || 0;
          keyCounts.set(key, occurrence + 1);
          trainEntry.dataset.key = JSON.stringify([key, occurrence]);
          trainEntry.classList.add('train-entry');
          trainEntry.setAttribute('data-line', lineKey);
          trainEntry.style.setProperty('--line-color', lineColor);
          trainEntry.style.height = rowHeight;
          if (isInverted) trainEntry.classList.add('inverted');
          if (isHolidayTrain === true) trainEntry.classList.add('holidayTrain')
          if (isPrideTrain === true) trainEntry.classList.add('prideTrain')

          let timingDisplay;
          if (arrival.isDelayed === "1") {
            timingDisplay = '<span class="bold">Delayed</span>';
          } else if (arrival.isArriving === "1" ||
            (arrival.route === 'Bus' && arrival.isArriving === true) ||
            (arrival.arrivalTime >= 0 && arrival.arrivalTime <= (arrival.route === 'Bus' ? 2 : 1))) {
            timingDisplay = '<span class="bold">Due</span>';
          } else if (arrival.route === 'Bus') {
            timingDisplay = `<span class="bold">${arrival.arrivalTime}</span> min`;
          } else {
            timingDisplay = `<span class="bold">${arrival.arrivalTime}</span> min`;
          }

          let trackingIcon = arrival.isScheduled === "1"
            ? (isInverted ? `/images/${lineKey}-scheduled.svg` : '/images/scheduled.svg')
            : (isInverted ? `/images/${lineKey}-live-tracked.svg` : '/images/live-tracked.svg');

          let candyCane = isHolidayTrain === true
            ? (isHolidayTrain ? `/images/candycane.svg` : '/images/candycane.svg')
            : (isHolidayTrain ? `/images/candycane.svg` : '/images/candycane.svg');

          trainEntry.innerHTML = `
        <div class="train-entry-number">${index + 1}</div>
        <div class="train-entry-body">
          <div class="train-entry-details">
            <span class="train-entry-run-info">${arrival.route === 'Bus'
              ? `Bus #${arrival.vehicleId} ${arrival.direction} at ${arrival.stationName}`
              : `${arrival.routeNameFull} #${arrival.routeNumber} at ${arrival.stationName} to`}</span>
            <span class="train-entry-dest">
              ${arrival.route === 'Bus' ? `Route #${arrival.routeNumber} to ${arrival.destination}` : arrival.destination}
              ${['Midway', "O'Hare"].includes(arrival.destination) ? '<img src="/images/icon_ttairport.svg" alt="Airport" style="height: 2.5rem; vertical-align: middle;" />' : ''}
              ${[true].includes(isHolidayTrain) ? '<img src="/images/candycane.svg" alt="Airport" style="height: 2.5rem; vertical-align: middle;" />' : ''}
              ${[true].includes(isHolidayTrain) ? '<img src="images/santa-sleigh.svg" alt="Santas Sleigh" style="height: 2.5rem; vertical-align: middle;" />' : ''}
            </span>
          </div>
          <div class="train-entry-timing">${timingDisplay}</div>
        </div>
      `;

          const trackingImg = getCachedImage(trackingIcon);
          const trackingDiv = document.createElement('div');
          trackingDiv.classList.add('train-entry-tracking');
          trackingDiv.appendChild(trackingImg);
          trainEntry.querySelector('.train-entry-body').appendChild(trackingDiv);

          return trainEntry;
        });

        await updateArrivalRows(container, nextRows, slideDuration);
        markArrivalsRefreshed();

      } catch (error) {
        console.error('Error fetching data:', error);
        document.querySelector('.loading').textContent = 'Failed to load data.';
        const warning = document.getElementById('sourceWarning');
        warning.textContent = 'Failed to refresh arrivals. Previously loaded estimates may be out of date.';
        warning.hidden = false;
      } finally {
        refreshInProgress = false;
      }
    }

    window.onload = () => {
      fetchArrivals();
      setInterval(fetchArrivals, 60000);
    };

  </script>
</body>

</html>